{
  "name": "panel-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"electron .\"",
    "dev-web": "vite",
    "build": "vite build",
    "pack": "electron-builder",
    "format": "prettier --write \"src/**/*.{js,html,css}\""
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "onnxruntime-web": "^1.26.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "prettier": "3.8.3",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^3.4.0"
  },
  "build": {
    "appId": "com.echo.panel",
    "productName": "Echo Panel",
    "files": [
      "main.js",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
